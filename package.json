{
  "name": "fileforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simple tools for your files. Compress, resize and convert files privately, directly in your browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
